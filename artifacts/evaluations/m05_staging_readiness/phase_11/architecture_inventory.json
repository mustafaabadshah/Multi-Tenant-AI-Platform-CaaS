      { "prefix": "/api/v1/organizations", "module": "app.api.v1.organizations", "purpose": "Enterprise organization and department hierarchy" },
      { "prefix": "/api/v1/departments", "module": "app.api.v1.departments", "purpose": "Department CRUD and access control scoping" },
      { "prefix": "/api/v1/groups", "module": "app.api.v1.groups", "purpose": "Employee grouping and team membership" },
      { "prefix": "/api/v1/knowledge", "module": "app.api.v1.knowledge", "purpose": "Knowledge base management and assistant linking" },
      { "prefix": "/api/v1/documents", "module": "app.api.v1.documents", "purpose": "File ingestion, parsing, chunking, and version tracking" },
