# =============================================================================
# Multi-Tenant AI Platform / CaaS — Production & Staging Environment Template
# =============================================================================
# DO NOT commit real secrets or credentials into version control.
# Copy this template to .env on your deployment host (Render, AWS, etc.) or populate
# these variables in the Render Dashboard / Vercel Environment Variables Console.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Multi-Tenant AI Platform-CaaS"
API_V1_STR=/api/v1

# Frontend Production URL (used by FastAPI CORSMiddleware)
# Set this to your actual Vercel domain (e.g., https://app.yourdomain.com)
FRONTEND_URL=https://multi-tenant-ai-platform.vercel.app
BACKEND_URL=https://mmaip-backend.onrender.com

# -----------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS (MANDATORY IN PRODUCTION)
# -----------------------------------------------------------------------------
# Generate high-entropy strings using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-64-character-hex-string
JWT_SECRET=change-me-to-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# BYOK Credential Encryption Key (Fernet 32-byte URL-safe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
# Comma-separated previous keys during rotation:
PREVIOUS_SECRET_KEYS=

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 16 with pgvector)
# -----------------------------------------------------------------------------
# Asyncpg driver for FastAPI async repositories:
DATABASE_URL=postgresql+asyncpg://mmaip_user:STRONG_PASSWORD_HERE@mmaip-postgres:5432/mmaip_staging
# Synchronous driver for Alembic migrations:
DATABASE_SYNC_URL=postgresql://mmaip_user:STRONG_PASSWORD_HERE@mmaip-postgres:5432/mmaip_staging

# -----------------------------------------------------------------------------
# 4. STORAGE & FILE RETENTION
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_PATH=/app/data/storage
MAX_FILE_SIZE_BYTES=52428800
MAX_FILES_PER_REQUEST=10
MAX_EXTRACTED_TEXT_SIZE_BYTES=20971520

# -----------------------------------------------------------------------------
# 5. RETRIEVAL & VECTOR SEARCH
# -----------------------------------------------------------------------------
DEFAULT_RETRIEVAL_MODE=hybrid
DEFAULT_VECTOR_STORE=pgvector
DEFAULT_EMBEDDING_PROVIDER=sentence-transformers
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
RRF_K_CONSTANT=60

# Optional Qdrant Vector Store
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key

# -----------------------------------------------------------------------------
# 6. LLM GATEWAY (OmniRoute or Direct BYOK)
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OMNIROUTE_API_KEY=
LLM_DEFAULT_MODEL=auto

# -----------------------------------------------------------------------------
# 7. VERCEL FRONTEND VARIABLE (Set this in Vercel Console only)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://mmaip-backend.onrender.com
