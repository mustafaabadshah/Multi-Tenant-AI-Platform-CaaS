# =============================================================================
# Multi-Tenant AI Platform / CaaS — Production & Staging Environment Template
# =============================================================================
# DO NOT commit real secrets or credentials into version control.
# Copy this template to .env on your deployment host (Render, AWS, etc.) or populate
# these variables in the Render Dashboard / Vercel Environment Variables Console.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# -----------------------------------------------------------------------------
ENVIRONMENT=production
# Registration policy: public self-service registration is disabled in production.
# Invite members from within their workspace instead.
ALLOW_PUBLIC_REGISTRATION=false
DEBUG=false
PROJECT_NAME="Multi-Tenant AI Platform-CaaS"
API_V1_STR=/api/v1

# Frontend Production URL (used by FastAPI CORSMiddleware)
# Set this to your actual Vercel domain (e.g., https://app.yourdomain.com)
FRONTEND_URL=https://multi-tenant-ai-platform.vercel.app
BACKEND_URL=https://mmaip-backend.onrender.com

# CORS (production policy is fail-closed: localhost/LAN origins are rejected)
# Comma-separated extra trusted origins if needed:
ALLOWED_ORIGINS=
# Development-only LAN regex is NEVER applied in production (ignored here).
ALLOW_DEV_LAN_ORIGINS=false
# Optional regex for preview domains (e.g. Vercel preview deployments):
CORS_ORIGIN_REGEX=^https://mmaip-frontend(-[a-zA-Z0-9_-]+)?\.vercel\.app$

# -----------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS (MANDATORY IN PRODUCTION)
# -----------------------------------------------------------------------------
# Generate high-entropy strings using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-64-character-hex-string
JWT_SECRET=change-me-to-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# RATE LIMITING (first-stage, per-process; no Redis required)
# -----------------------------------------------------------------------------
# Master switch. When false, all rate-limit checks are skipped.
RATE_LIMIT_ENABLED=true
# Comma-separated IPs of trusted reverse proxies/load balancers. Only these
# peers may supply X-Forwarded-For. Leave empty when the app is directly exposed.
TRUSTED_PROXY_IPS=
# Effective cluster-wide limit is approximately value x worker process count.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_INVITE_ACCEPT_PER_HOUR=20
RATE_LIMIT_PUBLIC_MESSAGE_PER_MINUTE=20
RATE_LIMIT_DEVELOPER_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_HOUR=60

# BYOK Credential Encryption Key (Fernet 32-byte URL-safe base64 key; used for BYOK secret encryption, falls back to SECRET_KEY when unset)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
# Comma-separated previous keys during rotation:
PREVIOUS_SECRET_KEYS=

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 16 with pgvector)
# -----------------------------------------------------------------------------
# Asyncpg driver for FastAPI async repositories:
DATABASE_URL=postgresql+asyncpg://mmaip_user:STRONG_PASSWORD_HERE@mmaip-postgres:5432/mmaip_staging
# Synchronous driver for Alembic migrations:
DATABASE_SYNC_URL=postgresql://mmaip_user:STRONG_PASSWORD_HERE@mmaip-postgres:5432/mmaip_staging

# -----------------------------------------------------------------------------
# 3b. BACKGROUND INGESTION DISPATCH & LEASE (Milestone 11)
# -----------------------------------------------------------------------------
# Keep the in-process dispatcher enabled for a single API process. It is safe
# to run alongside the compose worker profile because claims are atomic.
INGESTION_INLINE_DISPATCHER_ENABLED=true
INGESTION_DISPATCHER_POLL_SECONDS=2
# Must exceed the longest expected ingestion job. No heartbeat is implemented,
# so a job exceeding this lease can be requeued and executed twice.
INGESTION_LEASE_SECONDS=3600
INGESTION_MAX_CONCURRENCY=1

# -----------------------------------------------------------------------------
# 4. STORAGE & FILE RETENTION
# -----------------------------------------------------------------------------
# Production MUST use durable S3-compatible object storage. STORAGE_BACKEND=local
# is rejected at startup in production (Render filesystem is ephemeral).
STORAGE_BACKEND=s3
# Bucket name (required):
S3_BUCKET_NAME=your-production-bucket-name
# Endpoint URL: leave empty for AWS S3; set for Cloudflare R2 / MinIO / compatible:
#   AWS S3:                (empty)
#   Cloudflare R2:         https://<account-id>.r2.cloudflarestorage.com
#   MinIO self-hosted:     https://minio.yourdomain.com
S3_ENDPOINT_URL=
# Static credentials (required when S3_ENDPOINT_URL is set; for AWS with IAM
# roles these may be omitted):
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1
MAX_FILE_SIZE_BYTES=52428800
MAX_FILES_PER_REQUEST=10
MAX_EXTRACTED_TEXT_SIZE_BYTES=20971520

# -----------------------------------------------------------------------------
# 5. RETRIEVAL & VECTOR SEARCH
# -----------------------------------------------------------------------------
DEFAULT_RETRIEVAL_MODE=hybrid
DEFAULT_VECTOR_STORE=pgvector
DEFAULT_EMBEDDING_PROVIDER=sentence-transformers
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
RRF_K_CONSTANT=60

# Optional Qdrant Vector Store
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key

# -----------------------------------------------------------------------------
# 6. LLM GATEWAY (OmniRoute is OPTIONAL — direct BYOK providers work independently)
# -----------------------------------------------------------------------------
# Provider or gateway endpoint approved for this deployment (set at deploy time).
# Direct BYOK example: https://api.openai.com/v1
# OmniRoute example:  http://<gateway-host>:20128/v1
LLM_BASE_URL=https://<approved-provider-or-gateway>/v1
OPENAI_API_KEY=
# OmniRoute local gateway (only when explicitly deployed; set LLM_BASE_URL=http://<gateway-host>:20128/v1):
OMNIROUTE_API_KEY=
# NOTE: assistants store their own provider/model. "auto" is only valid for the
# OmniRoute gateway and Groq (auto-resolved to a concrete model). Direct
# providers (openai/anthropic/gemini) require explicit model selection.
# No deployment-wide default is pinned in the blueprint; choose it at deploy time.
# LLM_DEFAULT_MODEL=<explicit-model-for-direct-providers>

# -----------------------------------------------------------------------------
# 7. VERCEL FRONTEND VARIABLE (Set this in Vercel Console only)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://mmaip-backend.onrender.com
