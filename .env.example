# MM AI Platform - Environment Configuration Template
# Copy this file to .env and customize as needed. Never commit .env with real secrets.

# -----------------------------------------------------------------------------
# APPLICATION CORE
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MM AI Platform"
API_V1_STR=/api/v1

# Frontend & Backend Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security & Authentication (Change in production! Min 32 chars)
SECRET_KEY=dev-secret-key-change-me-in-production-min-32-bytes-long
JWT_SECRET=dev-jwt-secret-key-change-me-in-production-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# For Docker or local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mmaip_dev
# Sync DB URL for Alembic migrations if needed:
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/mmaip_dev
# Local SQLite fallback for lightweight testing/dev without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./data/mmaip_dev.db

# -----------------------------------------------------------------------------
# CACHE & VECTOR STORAGE (Optional Profiles)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local Filesystem Storage
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage

# Observability (Phoenix / OpenTelemetry)
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# -----------------------------------------------------------------------------
# AI GATEWAY & LLM INTEGRATION (OmniRoute Gateway)
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-here
OPENAI_API_KEY=your-omniroute-api-key-here
LLM_DEFAULT_MODEL=auto

# -----------------------------------------------------------------------------
# MILESTONE 03: EMBEDDINGS & RETRIEVAL ENGINE CONFIGURATION
# -----------------------------------------------------------------------------
# Default retrieval mode: 'hybrid', 'semantic', 'lexical'
DEFAULT_RETRIEVAL_MODE=hybrid
# Default vector store: 'pgvector', 'qdrant', 'fts'
DEFAULT_VECTOR_STORE=pgvector
# Default embedding provider: 'sentence-transformers', 'omniroute', 'openai', 'local', 'mock'
DEFAULT_EMBEDDING_PROVIDER=sentence-transformers
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

EMBEDDING_TIMEOUT_SECONDS=30
INDEXING_CONCURRENCY=4
RRF_K_CONSTANT=60

# Qdrant Vector Store configuration (when using Qdrant vector store)
QDRANT_COLLECTION=mmaip_chunks

# BYOK Secret Encryption Key (Fernet base64 32-byte key for encrypting provider API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
